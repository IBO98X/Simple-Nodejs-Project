<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Articles</title>
  </head>
  <body>
    <h1>All Articles Page</h1>
    <hr />
    <div style="background-color: orange; color: black; padding: 20px">
      <% for( let article of allArticles) { %>
        <h1 style="background-color: brown;"><%= article.title %></h1>
        <h5 style="background-color: aqua;"><%= article.body %></h5>
        <br />
        <hr />
      <% } %>
    </div>
  </body>
</html>
